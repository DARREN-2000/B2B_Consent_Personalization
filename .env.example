# ── Flask ──────────────────────────────────────────────────────────────────
FLASK_ENV=development

# ── Security — CHANGE THESE in production ─────────────────────────────────
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=jwt-change-me-in-production
ADMIN_API_KEY=changeme-admin-key

# ── Database ───────────────────────────────────────────────────────────────
# Leave blank to use SQLite (development default)
# DATABASE_URL=postgresql://consenthub:consenthub_secret@db:5432/consenthub
POSTGRES_DB=consenthub
POSTGRES_USER=consenthub
POSTGRES_PASSWORD=consenthub_secret

# ── CORS ───────────────────────────────────────────────────────────────────
# Use * for development; restrict in production
CORS_ORIGINS=*

# ── Ports ──────────────────────────────────────────────────────────────────
BACKEND_PORT=5000
FRONTEND_PORT=3000

# ── JWT Expiry ─────────────────────────────────────────────────────────────
JWT_ACCESS_HOURS=8
JWT_REFRESH_DAYS=30
